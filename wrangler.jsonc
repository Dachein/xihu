{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "xihu",
  "main": "worker/index.js",
  "compatibility_date": "2026-06-11",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
